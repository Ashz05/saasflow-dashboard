PROJECT_NAME="SaaSflow API"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretjwtkeyforlocaldevelopmentchangeinproduction"
ACCESS_TOKEN_EXPIRE_MINUTES=15

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saasflow

# Default local fallback database; switch to postgresql+asyncpg://postgres:postgres@localhost:5432/saasflow when postgres is active
DATABASE_URL=sqlite+aiosqlite:///./saasflow.db
